function hardcode_example:
    python:
        for i in range(20):
            emit("say hi")


function eval_example:
    # Available operators in order of operation: 
    # (, )      Parenthesis
    # ^         Exponent operator (compiles into a binary exponentiation loop)
    # *, /, %   Mutiplication, floor division, modulus
    # +, -      Addition, subtraction

    # Constants inside eval statements will be precomputed as much as possible
    python:
        bl.eval("#result:example_var = 8 + 6 - 7 * 5 / 3 % 9")
    tellraw @s ["Result 1: ",{"score":{"name":"#result","objective":"example_var"}}]

    # But calculations requiring variables or macros will be runtime-only
    scoreboard players set #a example_var 8
    scoreboard players set #b example_var 6
    scoreboard players set #c example_var 7
    scoreboard players set #d example_var 5
    scoreboard players set #e example_var 3
    scoreboard players set #f example_var 9
    python:
        bl.eval("#result:example_var = #a:example_var + #b:example_var - #c:example_var * #d:example_var / #e:example_var % #f:example_var")
    tellraw @s ["Result 2: ",{"score":{"name":"#result","objective":"example_var"}}]


function locators_example:
    # These are all available inside every python: block for free.
    python:
        emit(f"say Relative filepath: '{bl.PATH}'")
        emit(f"say Datapack name: '{bl.PACK_NAME}'")
        emit(f"say Namespace: '{bl.NAMESPACE}'")
        emit(f"say Source file: '{bl.FILE}'")
        emit(f"say Function name: '{bl.FUNCTION}'")
        emit(f"say Pack format / minimum pack format: '{bl.PACK_FORMAT}'")  # Major pack version only (e.g. 107)
        emit(f"say Blocklight version: '{bl.BLOCKLIGHT_VERSION}'")