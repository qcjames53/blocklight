function macros_demo_a:
    # Macros will survive any scoping within a function...
    as @s:
        at @s:
            positioned ~ ~ ~:
                say $(a) from macros_demo_a

    # ...but are required to be explicitly passed into other functions.
    function bl_example:macros/macros_demo_b with {"a": "$(a)"} 
    
function macros_demo_b:
    # Prepending '$' to macro commands is optional.
    say $(a) from macros_demo_b

function macros_demo_runner:
    function bl_example:macros/macros_demo_a with {"a": "hello"}