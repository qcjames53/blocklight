function hardcode_example
    python
        for i in range(20):
            emit("say hi")


function locators_example
    # These constants are available inside every `python` block for free.
    python
        SOURCE_FILEPATH  # Filepath of this file (e.g. "data/foo/blocklight/bar/baz.bl")
        FUNCTION_NAME  # Name of this function (e.g. "baz")
        FUNCTION_ID  # Callable output function ID (e.g. "foo:bar/baz")
        OUTPUT_FILEPATH  # Filepath of the current output file (e.g. "data/foo/function/bar/baz.mcfunction")
        HELPER_ID  # Callable output function ID of current helper (e.g. "foo:bar/baz_helper/as_0")
        SIBLING_ID_PREFIX  # Append names of other functions in this file to call (e.g. "foo:bar/" + "other_function")
        PACK_NAME  # Datapack name (e.g. "example_pack")
        PACK_FORMAT  # Datapack format (e.g. 107)
        BLOCKLIGHT_VERSION  # (e.g. 1.1)


# A `python` block at the top level must emit whole functions, which compile just like ones written by hand.
python
    for i in range(3):
        emit(f"function generated_{i}")
        emit(f"    say Hello, generated function {i}!")
